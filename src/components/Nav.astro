---
import { site } from '../data/site';

const pages = [
  { href: '/', label: 'About' },
  { href: '/research', label: 'Research' },
  { href: '/quant', label: 'Quant' },
  { href: '/publications', label: 'Publications' },
  { href: '/cv', label: 'CV' },
];
---

<nav class="site-nav">
  <div class="container">
    <a class="brand" href="/">{site.name}</a>
    <ul>
      {pages.map((p) => (
        <li><a href={p.href}>{p.label}</a></li>
      ))}
    </ul>
  </div>
</nav>
