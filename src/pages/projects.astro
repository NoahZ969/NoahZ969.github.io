---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects">
  <h1>Projects</h1>
  <p class="empty">
    A space for academic and professional projects. Interactive demos will live as individual
    project pages here, each one keeping its JS scoped via Astro islands so the rest of the site
    stays fast.
  </p>

  <div class="project-grid">
    <article class="project-card">
      <h3>Placeholder project</h3>
      <p>Short description. Replace this with a real project once you have one to showcase.</p>
    </article>
  </div>
</BaseLayout>
