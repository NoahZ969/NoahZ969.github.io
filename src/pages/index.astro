---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout description={site.bio.en} bgImage="/bg/general.jpeg">
  <section class="hero">
    {site.photoUrl && (
      <img src={site.photoUrl} alt={`Photo of ${site.name.en}`} />
    )}
    <div class="meta">
      <h1>
        <span data-lang="en">{site.name.en}</span>
        <span data-lang="zh">{site.name.zh}</span>
      </h1>
      <p class="role">
        <span data-lang="en">{site.role.en}</span>
        <span data-lang="zh">{site.role.zh}</span>
      </p>
      <p class="role">
        <span data-lang="en">{site.affiliation.en} &middot; {site.location.en}</span>
        <span data-lang="zh">{site.affiliation.zh} &middot; {site.location.zh}</span>
      </p>
      <ul class="links">
        {site.links.map((link) => (
          <li><a href={link.url} target="_blank" rel="noopener">{link.label}</a></li>
        ))}
        <li>
          <a href={`mailto:${site.email}`}>
            <span data-lang="en">Email</span>
            <span data-lang="zh">邮箱</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section>
    <h2>
      <span data-lang="en">About</span>
      <span data-lang="zh">关于</span>
    </h2>
    <p data-lang="en">{site.bio.en}</p>
    <p data-lang="zh">{site.bio.zh}</p>
  </section>
</BaseLayout>
