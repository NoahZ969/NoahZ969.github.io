---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications, syncedAt } from '../data/publications';
import { featured, findFeatured } from '../data/featured';
import { site } from '../data/site';

const sorted = [...publications].sort(
  (a, b) => (b.year ?? 0) - (a.year ?? 0) || (b.citedBy ?? 0) - (a.citedBy ?? 0)
);

const selected = featured
  .map((f) => {
    const pub = sorted.find((p) => findFeatured(p) === f);
    return pub && { ...pub, doi: pub.doi ?? f.doi, role: f.role };
  })
  .filter((entry) => entry !== undefined);

const rest = sorted.filter((p) => !findFeatured(p));

const scholarUrl = site.links.find((l) => l.label === 'Google Scholar')?.url;
const synced = new Date(syncedAt);
const syncedEn = synced.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const syncedZh = `${synced.getUTCFullYear()} 年 ${synced.getUTCMonth() + 1} 月 ${synced.getUTCDate()} 日`;
---

<BaseLayout title="Publications" bgImage="/bg/publication.jpeg">
  <h1>
    <span data-lang="en">Publications</span>
    <span data-lang="zh">论文</span>
  </h1>

  {sorted.length === 0 ? (
    <>
      <p class="empty" data-lang="en">
        Publication list will appear here once <code>npm run fetch-publications</code> has run
        with a <code>SERPAPI_KEY</code> available.
      </p>
      <p class="empty" data-lang="zh">
        在配置 <code>SERPAPI_KEY</code> 并运行 <code>npm run fetch-publications</code> 后，
        论文列表将在此显示。
      </p>
    </>
  ) : (
    <>
      <p class="role">
        <span data-lang="en">
          {sorted.length} entries, synced automatically from
          <a href={scholarUrl} target="_blank" rel="noopener">Google Scholar</a>
          &middot; last updated {syncedEn}.
        </span>
        <span data-lang="zh">
          共 {sorted.length} 篇，自动同步自
          <a href={scholarUrl} target="_blank" rel="noopener">Google Scholar</a>
          &middot; 最后更新于 {syncedZh}。
        </span>
      </p>

      {selected.length > 0 && (
        <>
          <h2>
            <span data-lang="en">Selected work</span>
            <span data-lang="zh">代表性成果</span>
          </h2>
          <ul class="pub-list featured">
            {selected.map((pub) => (
              <li>
                <div class="title">{pub.title}</div>
                <div class="meta">
                  <span class="badge">
                    <span data-lang="en">{pub.role.en}</span>
                    <span data-lang="zh">{pub.role.zh}</span>
                  </span>
                </div>
                <div class="meta">
                  <span>{pub.authors}</span>
                  {pub.venue
                    ? <span> &middot; <em>{pub.venue}</em></span>
                    : pub.year && <span> &middot; {pub.year}</span>}
                </div>
                <div class="meta">
                  {pub.arxivId && <a href={`https://arxiv.org/abs/${pub.arxivId}`} target="_blank" rel="noopener">arXiv:{pub.arxivId}</a>}
                  {pub.doi && <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">doi:{pub.doi}</a>}
                  {pub.url && <a href={pub.url} target="_blank" rel="noopener">Scholar</a>}
                  {pub.citedBy && (
                    <span>
                      <span data-lang="en">Cited by {pub.citedBy}</span>
                      <span data-lang="zh">被引 {pub.citedBy}</span>
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>

          <h2>
            <span data-lang="en">Other publications</span>
            <span data-lang="zh">其他论文</span>
          </h2>
        </>
      )}

      <ul class="pub-list">
        {rest.map((pub) => (
          <li>
            <div class="title">{pub.title}</div>
            <div class="meta">
              <span>{pub.authors}</span>
              {pub.venue
                ? <span> &middot; <em>{pub.venue}</em></span>
                : pub.year && <span> &middot; {pub.year}</span>}
            </div>
            <div class="meta">
              {pub.arxivId && <a href={`https://arxiv.org/abs/${pub.arxivId}`} target="_blank" rel="noopener">arXiv:{pub.arxivId}</a>}
              {pub.doi && <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">doi:{pub.doi}</a>}
              {pub.dccId && <a href={`https://dcc.ligo.org/${pub.dccId}`} target="_blank" rel="noopener">DCC:{pub.dccId}</a>}
              {pub.url && <a href={pub.url} target="_blank" rel="noopener">Scholar</a>}
              {pub.citedBy && (
                <span>
                  <span data-lang="en">Cited by {pub.citedBy}</span>
                  <span data-lang="zh">被引 {pub.citedBy}</span>
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
